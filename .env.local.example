NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — app notification emails (admin pending-review alerts, interest
# received, mutual match). Without these, sendEmail() logs and no-ops.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Required only if you enable Supabase's "Send Email" Auth Hook pointing at
# /api/auth/email-hook, to fully replace Supabase's own auth email sending
# (signup confirmation, password recovery) with Resend. Copy the secret
# Supabase shows when you enable the hook (starts with "v1,whsec_").
SUPABASE_AUTH_HOOK_SECRET=
