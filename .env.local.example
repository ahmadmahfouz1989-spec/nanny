NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — app notification emails (admin pending-review alerts, interest
# received, mutual match). Without these, sendEmail() logs and no-ops.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional fallback used when Resend has no verified domain (its sandbox
# mode only delivers to your own Resend account email) or fails outright.
# Uses a real Gmail account over SMTP — no domain needed. SMTP_PASSWORD
# must be a Gmail "App Password" (Google Account > Security > 2-Step
# Verification > App passwords), not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required only if you enable Supabase's "Send Email" Auth Hook pointing at
# /api/auth/email-hook, to fully replace Supabase's own auth email sending
# (signup confirmation, password recovery) with Resend. Copy the secret
# Supabase shows when you enable the hook (starts with "v1,whsec_").
SUPABASE_AUTH_HOOK_SECRET=

# Optional, improves email deliverability. EMAIL_REPLY_TO is a real
# monitored address (better than a noreply@ From). EMAIL_UNSUBSCRIBE is a
# mailto: or https:// target for the List-Unsubscribe header.
EMAIL_REPLY_TO=
EMAIL_UNSUBSCRIBE=

# Shown on the /subscribe page as the Whish target for the $6/month or
# $50/year payment. Payment is off-app: users pay this number and an admin
# activates the account from the admin console. NEXT_PUBLIC_ so the
# subscribe page (a client component) can read them.
NEXT_PUBLIC_WHISH_NUMBER=
NEXT_PUBLIC_WHISH_NAME=
NEXT_PUBLIC_WHISH_NOTE=
